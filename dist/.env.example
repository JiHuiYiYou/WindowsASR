# ==========================================
# 阿里云 NLS（语音交互）配置
# 前往阿里云控制台 → AccessKey 管理 → 创建子账号 AccessKey
# 权限建议：仅授予 AliyunNLSReadOnlyAccess
# ==========================================
ACCESS_KEY_ID=your_aliyun_access_key_id_here
ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here
APPKEY=your_nls_appkey_here


# ==========================================
# LLM（大语言模型）配置
# 示例使用 DeepSeek，也可替换为 OpenAI / 通义千问 等
# ==========================================
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat